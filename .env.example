# Dashboard: Authentication → Providers → enable "Email" (this app signs in with email only; anonymous is not used.)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# 로그인 화면 없이 메인만 먼저 보려면 true. 단, DB는 auth.uid()가 있어야 하므로 아래 개발 자동 로그인(또는 토큰 고정)과 같이 쓰지 않으면 "로그인이 필요합니다" 불러오기 오류가 납니다.
# EXPO_PUBLIC_BYPASS_EMAIL_AUTH_GATE=true

# ── 개발 전용 (반드시 로컬 `.env`에만 넣고 Git에 올리지 마세요) ─────────────────
# 구절이 이미 있는 세션을 고정하려면: 그 환경에서 로그인된 채로 access / refresh 토큰을 복사합니다.
# 웹: DevTools → Application → Local Storage → `sb-<project-ref>-auth-token` 값(JSON) 안의
#     `access_token`, `refresh_token` (또는 중첩된 currentSession 필드 — Supabase 버전에 따라 구조가 다를 수 있음)
# 토큰은 만료되면 다시 복사해야 합니다. 값에 따옴표는 넣지 않습니다.
# EXPO_PUBLIC_DEV_SUPABASE_ACCESS_TOKEN=
# EXPO_PUBLIC_DEV_SUPABASE_REFRESH_TOKEN=

# 선택: 개발 빌드에서만 이메일 @ 앞(local-part)을 한 값으로 고정 테스트할 때 (예: dudeson). 비우거나 두지 않으면 제한 없음.
# EXPO_PUBLIC_DEV_EMAIL_LOCAL_PART_ONLY=

# 선택: 개발 시 자동 이메일 로그인. 위 LOCAL_PART 전용 변수가 설정돼 있으면 그 문자열과 @ 앞이 맞아야 함.
# EXPO_PUBLIC_DEV_LOGIN_EMAIL=you@example.com
# EXPO_PUBLIC_DEV_LOGIN_PASSWORD=your_secret_password_here
